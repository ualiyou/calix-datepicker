[
  {
    "name": "@calix/core",
    "path": "packages/core/dist/index.js",
    "limit": "8 kB"
  },
  {
    "name": "@calix/react (with core)",
    "path": "packages/react/dist/index.js",
    "import": "{ DatePicker }",
    "limit": "16 kB",
    "ignore": ["react", "react-dom", "@floating-ui/react", "motion"]
  },
  {
    "name": "@calix/adapter-gregorian",
    "path": "packages/adapters/gregorian/dist/index.js",
    "limit": "6 kB",
    "ignore": ["date-fns", "@calix/core"]
  },
  {
    "name": "@calix/adapter-jalali",
    "path": "packages/adapters/jalali/dist/index.js",
    "limit": "6 kB",
    "ignore": ["date-fns-jalali", "@calix/core"]
  },
  {
    "name": "@calix/icons",
    "path": "packages/icons/dist/index.js",
    "limit": "4 kB",
    "ignore": ["react"]
  },
  {
    "name": "@calix/themes/default",
    "path": "packages/themes/default.css",
    "limit": "8 kB"
  }
]
