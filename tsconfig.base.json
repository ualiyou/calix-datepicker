{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "paths": {
      "@alydev/core": ["./packages/core/src/index.ts"],
      "@alydev/core/*": ["./packages/core/src/*"],
      "@alydev/datepicker": ["./packages/react/src/index.ts"],
      "@alydev/datepicker/*": ["./packages/react/src/*"],
      "@alydev/adapter-gregorian": ["./packages/adapters/gregorian/src/index.ts"],
      "@alydev/adapter-jalali": ["./packages/adapters/jalali/src/index.ts"],
      "@alydev/holidays-international": ["./packages/holidays/international/src/index.ts"],
      "@alydev/holidays-iran": ["./packages/holidays/iran/src/index.ts"],
      "@alydev/icons": ["./packages/icons/src/index.tsx"],
      "@alydev/icons/*": ["./packages/icons/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}
