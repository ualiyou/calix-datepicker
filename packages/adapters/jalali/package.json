{
  "name": "@calix/adapter-jalali",
  "version": "0.0.0",
  "description": "Jalali (Persian/Shamsi) calendar adapter for Calix, powered by date-fns-jalali.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/calix-ui/calix-datepicker.git",
    "directory": "packages/adapters/jalali"
  },
  "keywords": ["calendar", "datepicker", "jalali", "persian", "shamsi", "calix"],
  "files": ["dist"],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "@calix/core": "workspace:*"
  },
  "dependencies": {
    "date-fns-jalali": "^4.1.0-0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "@calix/core": "workspace:*",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8"
  }
}
