{
  "name": "@alydev/datepicker",
  "version": "2.0.0",
  "description": "Accessible, headless React date picker with Gregorian and Jalali calendars, RTL, time, ranges, and TypeScript.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "author": "Calix contributors",
  "homepage": "https://ualiyou.github.io/calix-datepicker/",
  "bugs": "https://github.com/ualiyou/calix-datepicker/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/ualiyou/calix-datepicker.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "datepicker",
    "calendar",
    "date-picker",
    "react-date-picker",
    "accessible",
    "typescript",
    "rtl",
    "persian",
    "headless",
    "jalali",
    "gregorian",
    "calix"
  ],
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "@alydev/core": "workspace:*",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.2"
  },
  "devDependencies": {
    "@alydev/adapter-gregorian": "workspace:*",
    "@alydev/adapter-jalali": "workspace:*",
    "@alydev/core": "workspace:*",
    "@alydev/holidays-international": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8"
  }
}
