{
  "name": "@calix/core",
  "version": "0.0.0",
  "description": "Framework-agnostic calendar engine, adapter interface, and selection strategies for Calix.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "author": "Calix contributors",
  "homepage": "https://calix.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/calix-ui/calix-datepicker.git",
    "directory": "packages/core"
  },
  "keywords": ["calendar", "datepicker", "date", "jalali", "gregorian", "headless"],
  "files": ["dist"],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8"
  }
}
